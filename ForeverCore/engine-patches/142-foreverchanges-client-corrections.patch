diff --git a/sim/mage/zz_forevercore_client_talents.go b/sim/mage/zz_forevercore_client_talents.go
new file mode 100644
index 0000000..cb7d261
--- /dev/null
+++ b/sim/mage/zz_forevercore_client_talents.go
@@ -0,0 +1,23 @@
+package mage
+
+import "strings"
+
+// The engine keeps its protobuf field numbers. Client 70658 removed Piercing Ice,
+// so insert its unused zero before decoding the current 18-node Frost string.
+func foreverCoreMageTalents(value string) string {
+	parts := strings.Split(value, "-")
+	if len(parts) < 3 {
+		return value
+	}
+	frost := parts[2]
+	if len(frost) > 18 {
+		panic("obsolete Mage Frost talent string: rebuild from current talent geometry")
+	}
+	if len(frost) > 2 && frost[2] > '3' {
+		panic("Elemental Precision has at most 3 ranks")
+	}
+	if len(frost) > 7 {
+		parts[2] = frost[:7] + "0" + frost[7:]
+	}
+	return strings.Join(parts, "-")
+}
diff --git a/sim/mage/zz_forevercore_client_talents_test.go b/sim/mage/zz_forevercore_client_talents_test.go
