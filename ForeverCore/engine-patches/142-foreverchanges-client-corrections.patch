@@ -0,0 +1,31 @@
+package mage
+
+import (
+	"github.com/wowsims/forever/sim/core"
+	"github.com/wowsims/forever/sim/core/proto"
+	"github.com/wowsims/forever/sim/core/stats"
+	"testing"
+)
+
+func TestForeverCoreCurrentFrostOrder(t *testing.T) {
+	ranks := []byte("000000000000000000")
+	ranks[2], ranks[7], ranks[8], ranks[9], ranks[17] = '3', '2', '1', '3', '1'
+	value := &proto.MageTalents{}
+	core.FillTalentsProto(value.ProtoReflect(), foreverCoreMageTalents("--"+string(ranks)), TalentTreeSizes)
+	if value.ElementalPrecision != 3 || value.PiercingIce != 0 || value.FrostChanneling != 2 || !value.IceLance || value.ImprovedBlizzard != 3 || !value.IceBarrier {
+		t.Fatalf("current talent order decoded into wrong engine fields: %v", value)
+	}
+}
+
+func TestForeverCoreElementalPrecisionCurrentValues(t *testing.T) {
+	for rank := 1; rank <= 3; rank++ {
+		ranks := []byte("000000000000000000")
+		ranks[2] = byte('0' + rank)
+		_, mage := newThreeTargetMage("--" + string(ranks))
+		for _, school := range []stats.SchoolIndex{stats.SchoolIndexFire, stats.SchoolIndexFrost} {
+			if got := mage.PseudoStats.SchoolBonusHitChance[school]; got != float64(rank*2) {
+				t.Fatalf("rank %d, school %v: got %v hit, want %v", rank, school, got, rank*2)
+			}
+		}
+	}
+}
