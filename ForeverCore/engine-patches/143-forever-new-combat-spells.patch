diff --git a/sim/hunter/kill_command.go b/sim/hunter/kill_command.go
new file mode 100644
index 0000000..fad48da
--- /dev/null
+++ b/sim/hunter/kill_command.go
@@ -0,0 +1,89 @@
+package hunter
+
+import (
+	"time"
+
+	"github.com/wowsims/forever/sim/core"
+)
+
+// Kill Command, new in Forever (spell 409379; client 1.60.1.70658, tooltip of Wowhead Forever and ForeverDB):
+//
+//	1.5% of base mana, instant, 1 min cooldown, 45 yd.
+//	"Give the command to kill, increasing your pet's damage done from Claw and Bite by 60% for 30 sec. Each Claw
+//	or Bite done by the pet reduces the damage bonus by 20%."
+//
+// The bonus is three charges: the first Claw or Bite deals +60%, the next +40%, the next +20%, then the aura is
+// gone (or after 30 s). The command is not on the global cooldown (confirmed in the game by the player of the
+// project; the tooltip does not say).
+const (
+	killCommandSpellID        = 409379
+	killCommandDuration       = 30 * time.Second
+	killCommandCooldown       = time.Minute
+	killCommandManaPercent    = 1.5
+	killCommandBonusPerCharge = 0.2
+	killCommandCharges        = 3
+)
+
+func (hunter *Hunter) registerKillCommand() {
+	pet := hunter.Pet
+	if pet == nil {
+		return // no pet, no command
+	}
+	actionID := core.ActionID{SpellID: killCommandSpellID}
+
+	damageMod := pet.AddDynamicMod(core.SpellModConfig{
+		Kind:       core.SpellMod_DamageDone_Pct,
+		ClassMask:  HunterPetClawBite,
+		FloatValue: killCommandBonusPerCharge * killCommandCharges,
+	})
+	aura := pet.RegisterAura(core.Aura{
+		Label:     "Kill Command",
+		ActionID:  actionID,
+		Duration:  killCommandDuration,
+		MaxStacks: killCommandCharges,
+		OnGain: func(aura *core.Aura, sim *core.Simulation) {
+			damageMod.UpdateFloatValue(killCommandBonusPerCharge * float64(killCommandCharges))
+			damageMod.Activate()
+		},
+		OnStacksChange: func(aura *core.Aura, sim *core.Simulation, oldStacks int32, newStacks int32) {
+			if newStacks > 0 {
+				damageMod.UpdateFloatValue(killCommandBonusPerCharge * float64(newStacks))
+			}
+		},
+		OnExpire: func(aura *core.Aura, sim *core.Simulation) {
+			damageMod.Deactivate()
+		},
+		// every Claw or Bite uses a charge, after its own damage has taken the current bonus
+		OnCastComplete: func(aura *core.Aura, sim *core.Simulation, spell *core.Spell) {
+			if spell.Matches(HunterPetClawBite) {
+				aura.RemoveStack(sim)
+			}
+		},
+	})
+
+	hunter.KillCommand = hunter.RegisterSpell(core.SpellConfig{
+		ActionID: actionID,
+		Flags:    core.SpellFlagAPL,
+
+		ManaCost: core.ManaCostOptions{
+			BaseCostPercent: killCommandManaPercent,
+		},
+		Cast: core.CastConfig{
+			DefaultCast: core.Cast{
+				GCD: 0, // off the global cooldown
+			},
+			CD: core.Cooldown{
+				Timer:    hunter.NewTimer(),
+				Duration: killCommandCooldown,
+			},
+		},
+		ExtraCastCondition: func(sim *core.Simulation, target *core.Unit) bool {
+			return pet.IsEnabled()
+		},
+
+		ApplyEffects: func(sim *core.Simulation, target *core.Unit, spell *core.Spell) {
+			aura.Activate(sim)
+			aura.SetStacks(sim, killCommandCharges)
+		},
+	})
+}
diff --git a/sim/hunter/kill_command_test.go b/sim/hunter/kill_command_test.go
new file mode 100644
index 0000000..dc3906b
--- /dev/null
+++ b/sim/hunter/kill_command_test.go
@@ -0,0 +1,92 @@
+package hunter
+
+import (
+	"math"
+	"testing"
+
+	"github.com/wowsims/forever/sim/core"
+	"github.com/wowsims/forever/sim/core/proto"
+)
+
+// Kill Command: +60% on the pet's Claw and Bite, a charge less (20%) with each of them, gone after three.
+func TestKillCommandChargesOnClawAndBite(t *testing.T) {
+	sim, hunter := aspectSim(MarksmanshipTalents)
+	pet := hunter.Pet
+	claw := pet.GetSpell(core.ActionID{SpellID: 3009})
+	bite := pet.GetSpell(core.ActionID{SpellID: 17261})
+	if claw == nil || bite == nil {
+		t.Fatal("the Cat has no Claw or Bite")
+	}
+	table := pet.AttackTables[hunter.CurrentTarget.UnitIndex]
+	multiplier := func(spell *core.Spell) float64 { return spell.AttackerDamageMultiplier(table, false) }
+	base := multiplier(claw)
+
+	aura := pet.GetAura("Kill Command")
+	if aura == nil {
+		t.Fatal("no Kill Command aura on the pet")
+	}
+	aura.Activate(sim)
+	aura.SetStacks(sim, killCommandCharges)
+
+	for i, want := range []float64{1.6, 1.4, 1.2} {
+		spell := claw
+		if i == 1 {
+			spell = bite // Claw and Bite use the same charges
+		}
+		if got := multiplier(spell) / base; math.Abs(got-want) > 1e-9 {
+			t.Fatalf("charge %d: Claw/Bite damage x%.3f, want x%.3f", i+1, got, want)
+		}
+		aura.OnCastComplete(aura, sim, spell)
+	}
+	if aura.IsActive() {
+		t.Error("Kill Command is still up after three Claws and Bites")
+	}
+	if got := multiplier(claw) / base; math.Abs(got-1) > 1e-9 {
+		t.Errorf("Claw still x%.3f after the charges are gone", got)
+	}
+}
+
+// The hunter casts it: 1 minute cooldown, so a 10 minute fight has ten casts at most, and its mana cost is 1.5% of
+// the base mana.
+func TestKillCommandIsCast(t *testing.T) {
+	sim, hunter := aspectSim(MarksmanshipTalents)
+	spell := hunter.KillCommand
+	if spell == nil {
+		t.Fatal("Kill Command is not registered")
+	}
+	if got, want := spell.DefaultCast.Cost, math.Floor(1.5*hunter.BaseMana/100); math.Abs(got-want) > 1 {
+		t.Errorf("Kill Command costs %v mana, want about %v (1.5%% of the base mana)", got, want)
+	}
+	if got := spell.CD.Duration.Seconds(); got != 60 {
+		t.Errorf("cooldown %v s, want 60", got)
+	}
+
+	apl := `{"type":"TypeAPL","priorityList":[{"action":{"castSpell":{"spellId":{"spellId":409379}}}}]}`
+	player := &proto.Player{
+		Name: "h", Class: proto.Class_ClassHunter, Race: proto.Race_RaceOrc, TalentsString: MarksmanshipTalents,
+		Equipment: WeaponsOnly, DistanceFromTarget: 5,
+		Spec: &proto.Player_Hunter{Hunter: &proto.Hunter{Options: &proto.Hunter_Options{ClassOptions: &proto.HunterOptions{
+			Ammo: proto.HunterOptions_Doomshot, QuiverBonus: proto.HunterOptions_Speed15, PetType: proto.HunterOptions_Cat,
+			PetAttackSpeed: proto.HunterOptions_OneTwo, PetUptime: 1}}}},
+		Rotation: core.APLRotationFromJsonString(apl),
+	}
+	raid := &proto.Raid{Parties: []*proto.Party{{Players: []*proto.Player{player}, Buffs: &proto.PartyBuffs{}}}, Buffs: &proto.RaidBuffs{}, Debuffs: &proto.Debuffs{}, NumActiveParties: 1}
+	res := core.RunRaidSim(&proto.RaidSimRequest{Raid: raid, Encounter: core.MakeSingleTargetEncounter(0), SimOptions: &proto.SimOptions{Iterations: 5, RandomSeed: 1}})
+	if res.Error != nil {
+		t.Fatal(res.Error.Message)
+	}
+	var casts float64
+	for _, action := range res.RaidMetrics.Parties[0].Players[0].Actions {
+		if action.Id.GetSpellId() == killCommandSpellID {
+			for _, target := range action.Targets {
+				casts += float64(target.Casts)
+			}
+		}
+	}
+	casts /= 5
+	want := float64(core.LongDuration) / 60
+	if casts < want-1.5 || casts > want+1.5 {
+		t.Errorf("%.1f Kill Commands in a %d s fight, want about %.0f (one a minute)", casts, core.LongDuration, want)
+	}
+	_ = sim
+}
