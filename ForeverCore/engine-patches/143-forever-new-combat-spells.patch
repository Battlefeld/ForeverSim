diff --git a/sim/rogue/shiv.go b/sim/rogue/shiv.go
new file mode 100644
index 0000000..3d69712
--- /dev/null
+++ b/sim/rogue/shiv.go
@@ -0,0 +1,83 @@
+package rogue
+
+import (
+	"github.com/wowsims/forever/sim/core"
+)
+
+// Shiv, new in Forever (spell 424799; client 1.60.1.70658, tooltips of Wowhead Forever and ForeverDB):
+//
+//	20 energy, melee range, instant.
+//	"Instantly attack with your off-hand weapon to deal normal off-hand weapon damage with a 100% chance to apply
+//	the poison from your off-hand weapon to the target. Slower weapons require more energy. Awards 1 combo point.
+//	Shiv benefits from all talents and effects that trigger from or modify Sinister Strike."
+//
+// What the tooltips leave open, and what is assumed here:
+//   - "normal off-hand weapon damage" is read as the off-hand weapon's damage (not normalised), with the usual
+//     off-hand penalty of the engine;
+//   - "slower weapons require more energy" has no stated rule: the cost is the 20 energy of the tooltip for every
+//     weapon, so a slow off-hand weapon costs too little here;
+//   - it takes the Sinister Strike class mask, which is how the talents and effects that modify Sinister Strike
+//     reach it.
+const (
+	shivSpellID = 424799
+	shivEnergy  = 20
+)
+
+func (rogue *Rogue) registerShivSpell() {
+	if !rogue.HasOHWeapon() {
+		return
+	}
+
+	rogue.Shiv = rogue.RegisterSpell(core.SpellConfig{
+		ActionID:       core.ActionID{SpellID: shivSpellID},
+		SpellSchool:    core.SpellSchoolPhysical,
+		DefenseType:    core.DefenseTypeMelee,
+		ProcMask:       core.ProcMaskMeleeOHSpecial,
+		Flags:          core.SpellFlagMeleeMetrics | SpellFlagBuilder | core.SpellFlagAPL,
+		ClassSpellMask: RogueSpellSinisterStrike,
+		MaxRange:       core.MaxMeleeRange,
+
+		EnergyCost: core.EnergyCostOptions{
+			Cost:   shivEnergy,
+			Refund: sinisterStrikeRank.MissRefund(),
+		},
+		Cast: core.CastConfig{
+			DefaultCast: core.Cast{
+				GCD: sinisterStrikeRank.GCD(),
+			},
+			IgnoreHaste: true,
+		},
+
+		DamageMultiplier:         1,
+		DamageMultiplierAdditive: 1,
+		ThreatMultiplier:         1,
+
+		ApplyEffects: func(sim *core.Simulation, target *core.Unit, spell *core.Spell) {
+			rogue.BreakStealth(sim)
+
+			damage := spell.Unit.OHWeaponDamage(sim, spell.MeleeAttackPower(target))
+			result := spell.CalcAndDealDamage(sim, target, damage, spell.OutcomeMeleeWeaponSpecialHitAndCrit)
+
+			if result.Landed() {
+				rogue.AddComboPoints(sim, 1, spell.ComboPointMetrics())
+				rogue.applyOffHandPoisons(sim, target)
+			} else {
+				spell.IssueRefund(sim)
+			}
+		},
+	})
+}
+
+// applyOffHandPoisons applies the poison on the off-hand weapon for certain, which is what Shiv does; the
+// weapon's own chance does not roll on a Shiv (see applyPoisonProc), so a poison is never applied twice.
+func (rogue *Rogue) applyOffHandPoisons(sim *core.Simulation, target *core.Unit) {
+	if rogue.Consumables.OhImbueId == deadlyImbueID && rogue.DeadlyPoison != nil {
+		rogue.DeadlyPoison.Cast(sim, target)
+	}
+	if rogue.Consumables.OhImbueId == woundImbueID && rogue.WoundPoison != nil {
+		rogue.WoundPoison.Cast(sim, target)
+	}
+	if rogue.Consumables.OhImbueId == instantImbueID && rogue.InstantPoison != nil {
+		rogue.InstantPoison.Cast(sim, target)
+	}
+}
diff --git a/sim/rogue/shiv_test.go b/sim/rogue/shiv_test.go
new file mode 100644
index 0000000..81fad1f
--- /dev/null
+++ b/sim/rogue/shiv_test.go
@@ -0,0 +1,69 @@
+package rogue
+
+import (
+	"math"
+	"testing"
+	"time"
+
+	"github.com/wowsims/forever/sim/core"
+	"github.com/wowsims/forever/sim/core/proto"
+)
+
+// Shiv: 20 energy, an off-hand attack that awards one combo point and applies the off-hand poison every time it
+// lands (and never when it misses); a poison is not applied twice, by the Shiv and by the weapon's own chance.
+func TestShivAwardsAPointAndAppliesTheOffHandPoison(t *testing.T) {
+	sim, rogue, target := newRogueProbe(t, &proto.ConsumesSpec{OhImbueId: deadlyImbueID})
+	if rogue.Shiv == nil {
+		t.Fatal("Shiv is not registered for a rogue with two daggers")
+	}
+	if got := rogue.Shiv.DefaultCast.Cost; got != 0 {
+		t.Logf("the cost is carried by the energy bar: %v", got)
+	}
+	poison := rogue.DeadlyPoison.Dot(target)
+
+	// the poison is a spell of its own and can be resisted like any other: a landed Shiv always casts it
+	landed, missed, applied := 0, 0, 0
+	for i := 0; i < 400; i++ {
+		advance(sim, 3*time.Second)
+		rogue.SpendEnergy(sim, rogue.CurrentEnergy(), rogue.NewEnergyMetrics(core.ActionID{OtherID: 1}))
+		rogue.AddEnergy(sim, 100, rogue.NewEnergyMetrics(core.ActionID{OtherID: 2}))
+		if poison.IsActive() {
+			poison.Deactivate(sim)
+		}
+		if rogue.ComboPoints() > 0 {
+			rogue.SpendComboPoints(sim, rogue.NewComboPointMetrics(core.ActionID{OtherID: 3}))
+		}
+
+		energy := rogue.CurrentEnergy()
+		if !rogue.Shiv.Cast(sim, target) {
+			t.Fatal("Shiv could not be cast with full energy")
+		}
+		spent := energy - rogue.CurrentEnergy()
+		if rogue.ComboPoints() == 1 {
+			landed++
+			if math.Abs(spent-shivEnergy) > 1e-9 {
+				t.Fatalf("a landed Shiv cost %v energy, want %d", spent, shivEnergy)
+			}
+			if poison.GetStacks() > 1 {
+				t.Fatalf("a landed Shiv left the Deadly Poison at %d stacks, want at most one application", poison.GetStacks())
+			}
+			if poison.IsActive() {
+				applied++
+			}
+		} else {
+			missed++
+			if rogue.ComboPoints() != 0 || poison.IsActive() {
+				t.Fatalf("a missed Shiv gave %d combo points and poison %v", rogue.ComboPoints(), poison.IsActive())
+			}
+		}
+	}
+	if landed < 250 || missed == 0 {
+		t.Errorf("%d Shivs landed and %d missed of 400, want mostly hits with some misses", landed, missed)
+	}
+	if casts := int(rogue.DeadlyPoison.SpellMetrics[target.UnitIndex].Casts); casts != landed {
+		t.Errorf("the Deadly Poison was cast %d times for %d landed Shivs, want once for each (not on a miss, not twice)", casts, landed)
+	}
+	if applied < landed*7/10 {
+		t.Errorf("the poison took on %d of %d landed Shivs, want most of them (it can be resisted)", applied, landed)
+	}
+}
