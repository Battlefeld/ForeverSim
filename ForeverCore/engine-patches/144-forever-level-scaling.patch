diff --git a/sim/mage/forever_scaling_test.go b/sim/mage/forever_scaling_test.go
new file mode 100644
index 0000000..78fa2e8
--- /dev/null
+++ b/sim/mage/forever_scaling_test.go
@@ -0,0 +1,104 @@
+package mage
+
+import (
+	"math"
+	"testing"
+
+	"github.com/wowsims/forever/sim/core/dbcenums"
+	"github.com/wowsims/forever/sim/core/spelldata"
+)
+
+// the effects whose base points are a coefficient of the level polynomial (spelldata.Effect.scalesWithLevel)
+func scalesWithLevel(e *spelldata.Effect) bool {
+	if e.BasePoints <= 0 {
+		return false
+	}
+	switch e.Type {
+	case dbcenums.E_SCHOOL_DAMAGE, dbcenums.E_HEAL:
+		return true
+	case dbcenums.E_APPLY_AURA:
+		return e.Aura == dbcenums.A_PERIODIC_DAMAGE || e.Aura == dbcenums.A_PERIODIC_HEAL
+	}
+	return false
+}
+
+// The tooltips of ForeverDB are written for level 30 ("Numbers at level 30; they grow with your level"). The
+// engine's amounts at level 30 must be those numbers; they were a flat 1.9 times too high (Starsurge 248 to 304
+// instead of 132 to 162) or, for Divine Light, half of what the tooltip says.
+func TestForeverScaledSpellsReadLikeTheTooltipsAtLevel30(t *testing.T) {
+	for _, c := range []struct {
+		id     int32
+		name   string
+		lo, hi float64
+	}{
+		{417157, "Starsurge", 132, 162},
+		{400610, "Arcane Barrage", 194, 237},
+		{425124, "Arcane Surge", 122, 143},
+		{428878, "Balefire Bolt", 151, 227},
+		{412532, "Spellfrost Bolt", 165, 192},
+		{403629, "Chaos Bolt", 289, 366},
+		{458856, "Divine Light", 748, 828},
+		{408247, "Nourish", 335, 393},
+		{431655, "Mind Spike", 78, 90},
+	} {
+		spell := spelldata.Find(c.id)
+		if spell == nil {
+			t.Fatalf("%s (%d) is not in the table", c.name, c.id)
+		}
+		var e *spelldata.Effect
+		for i := range spell.Effects {
+			if scalesWithLevel(&spell.Effects[i]) {
+				e = &spell.Effects[i]
+				break
+			}
+		}
+		if e == nil {
+			t.Fatalf("%s has no damage or healing effect", c.name)
+		}
+		if lo, hi := e.Min(30), e.Max(30); math.Abs(lo-c.lo) > 1 || math.Abs(hi-c.hi) > 1 {
+			t.Errorf("%s at level 30: %.1f to %.1f, the tooltip says %v to %v", c.name, lo, hi, c.lo, c.hi)
+		}
+	}
+}
+
+// A tick adds up to the tooltip's total: Living Bomb is 184 over 12 sec (4 ticks), Sunfire's damage over time 139.
+func TestForeverScaledTicksAddUpToTheTooltip(t *testing.T) {
+	for _, c := range []struct {
+		id    int32
+		name  string
+		ticks float64
+		total float64
+	}{{400613, "Living Bomb", 4, 184}, {414684, "Sunfire", 4, 139}} {
+		spell := spelldata.Find(c.id)
+		if spell == nil {
+			t.Fatalf("%s (%d) is not in the table", c.name, c.id)
+		}
+		found := false
+		for i := range spell.Effects {
+			e := &spell.Effects[i]
+			if scalesWithLevel(e) && e.Aura != 0 {
+				found = true
+				if got := e.Average(30) * c.ticks; math.Abs(got-c.total) > 1 {
+					t.Errorf("%s: %v ticks of %.2f add up to %.1f, the tooltip says %v", c.name, c.ticks, e.Average(30), got, c.total)
+				}
+			}
+		}
+		if !found {
+			t.Errorf("%s has no scaled periodic effect", c.name)
+		}
+	}
+}
+
+// The scaling follows the level, which is the point: a level 60 Starsurge is stronger than a level 30 one.
+func TestForeverScaledSpellGrowsWithTheLevel(t *testing.T) {
+	spell := spelldata.Find(417157)
+	var e *spelldata.Effect
+	for i := range spell.Effects {
+		if scalesWithLevel(&spell.Effects[i]) {
+			e = &spell.Effects[i]
+		}
+	}
+	if !(e.Average(10) < e.Average(30) && e.Average(30) < e.Average(60)) {
+		t.Errorf("Starsurge at 10/30/60: %.1f %.1f %.1f, want rising", e.Average(10), e.Average(30), e.Average(60))
+	}
+}
