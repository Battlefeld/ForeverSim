diff --git a/sim/core/spelldata/forever_scaling.go b/sim/core/spelldata/forever_scaling.go
new file mode 100644
index 0000000..9d7d8a5
--- /dev/null
+++ b/sim/core/spelldata/forever_scaling.go
@@ -0,0 +1,33 @@
+package spelldata
+
+import "github.com/wowsims/forever/sim/core/dbcenums"
+
+// LevelScale is the level polynomial Forever multiplies a spell's coefficient with: the tooltip of such a spell
+// reads "[N / 100 * (A + B * level + C * level * level)]", where N is the effect's base points.
+//
+// The newer Forever spells (the runes and the spells of the new class kits) are written that way; the table below
+// is generated by tools/spell-check/scaling.py from those tooltips (Wowhead Forever) and checked against the
+// tooltips of ForeverDB at level 30. Spells with ranks of the Classic kind have fixed numbers per rank and are not
+// in it. Without the table the engine used N as a flat amount at every level.
+type LevelScale struct{ A, B, C float64 }
+
+func (s LevelScale) At(level float64) float64 {
+	return s.A + s.B*level + s.C*level*level
+}
+
+// Whether the effect's base points are a coefficient of the level polynomial: a direct hit or heal, or a periodic
+// damage or heal aura (the base points of those are the amount of one tick).
+func (e *Effect) scalesWithLevel() bool {
+	if e.BasePoints <= 0 {
+		return false
+	}
+	switch e.Type {
+	case dbcenums.E_SCHOOL_DAMAGE, dbcenums.E_HEAL:
+		return true
+	case dbcenums.E_APPLY_AURA:
+		return e.Aura == dbcenums.A_PERIODIC_DAMAGE || e.Aura == dbcenums.A_PERIODIC_HEAL
+	}
+	return false
+}
+
+var foreverScales = map[int32]LevelScale{}
